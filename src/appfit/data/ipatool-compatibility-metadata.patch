@@ -232,0 +236,18 @@ func readVersionMetadataFromInfoPlist(file *zip.File) (versionMetadata, error) {
+	minimumOSVersion := strings.TrimSpace(fmt.Sprintf("%v", metadata["MinimumOSVersion"]))
+	if minimumOSVersion == "<nil>" {
+		minimumOSVersion = ""
+	}
+
+	deviceFamilies := []int{}
+	if raw, ok := metadata["UIDeviceFamily"]; ok {
+		value := reflect.ValueOf(raw)
+		if value.Kind() == reflect.Slice {
+			for i := 0; i < value.Len(); i++ {
+				family, parseErr := strconv.Atoi(fmt.Sprintf("%v", value.Index(i).Interface()))
+				if parseErr == nil {
+					deviceFamilies = append(deviceFamilies, family)
+				}
+			}
+		}
+	}
+
