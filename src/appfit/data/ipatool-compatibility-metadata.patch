+							Password: acc.Password,
+							AuthCode: authCode,
+						})
+					}
@@ -77,0 +101,9 @@ func purchaseCmd() *cobra.Command {
+
+func readPurchaseAuthCode() (string, error) {
+	authCode, err := bufio.NewReader(os.Stdin).ReadString('\n')
+	if err != nil {
+		return "", fmt.Errorf("failed to read auth code: %w", err)
+	}
+
+	return strings.TrimSpace(authCode), nil
+}
